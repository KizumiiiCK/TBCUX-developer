    m_Localized: "\u6709 {0}% \u7684\u6982\u7387\u9020\u6210\u4E00\u6B21\u66B4\u51FB\u4F24\u5BB3\uFF0C\u4F24\u5BB3\u7FFB1.75\u500D\u5E76\u5BF9\u94A2\u94C1\u654C\u4EBA\u6253\u51FA\u9AD8\u989D\u4F24\u5BB3\u3002"
