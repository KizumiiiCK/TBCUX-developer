# Ignore everything by default
/*

# Keep this file
!/.gitignore

# Keep the repository README
!/README.md

# Include only Unity folders we want to version
!/Resources/
!/Script/
!/Bundled/
!/AddressableAssetsData/

# Keep folder meta files for GUID stability
!/Resources.meta
!/Script.meta
!/Bundled.meta
!/AddressableAssetsData.meta

# Include all content under allowed folders
!/Resources/**
!/Script/**
!/Bundled/**
!/AddressableAssetsData/**

# Addressables linker file — regenerated on every content build
/AddressableAssetsData/link.xml
/AddressableAssetsData/link.xml.meta

# --- Exclude heavy peripheral media (kept locally, not versioned) ---
# These do not affect core game data (stats, level, localization, unit data).
# Re-ignored AFTER the whitelist above, so last-match-wins drops them.
# Addressables source lives under Bundled/; keep the old Resources/ rules
# in case leftover files remain.

# Fonts (TTF/OTF/TTC + generated TMP SDF atlases)
/Resources/System/**
/Bundled/System/**

# Music & sound tracks (keep .mixer routing asset)
/Resources/Music/**/*.mp3
/Resources/Music/**/*.MP3
/Resources/Music/**/*.ogg
/Resources/Music/**/*.mp3.meta
/Resources/Music/**/*.MP3.meta
/Resources/Music/**/*.ogg.meta
/Bundled/Music/**/*.mp3
/Bundled/Music/**/*.MP3
/Bundled/Music/**/*.ogg
/Bundled/Music/**/*.mp3.meta
/Bundled/Music/**/*.MP3.meta
/Bundled/Music/**/*.ogg.meta

# Cutscene videos (keep .renderTexture)
/Resources/video/**/*.mp4
/Resources/video/**/*.mp4.meta
/Bundled/video/**/*.mp4
/Bundled/video/**/*.mp4.meta

# CG artwork (keep shaders/materials)
/Resources/CG/**/*.png
/Resources/CG/**/*.PNG
/Resources/CG/**/*.jpg
/Resources/CG/**/*.JPG
/Resources/CG/**/*.png.meta
/Resources/CG/**/*.PNG.meta
/Resources/CG/**/*.jpg.meta
/Resources/CG/**/*.JPG.meta
/Bundled/CG/**/*.png
/Bundled/CG/**/*.PNG
/Bundled/CG/**/*.jpg
/Bundled/CG/**/*.JPG
/Bundled/CG/**/*.png.meta
/Bundled/CG/**/*.PNG.meta
/Bundled/CG/**/*.jpg.meta
/Bundled/CG/**/*.JPG.meta

# Dialogue portrait art (keep DialoguePortraitSettings.asset)
/Resources/DialogueImage/**/*.png
/Resources/DialogueImage/**/*.PNG
/Resources/DialogueImage/**/*.png.meta
/Resources/DialogueImage/**/*.PNG.meta
/Bundled/DialogueImage/**/*.png
/Bundled/DialogueImage/**/*.PNG
/Bundled/DialogueImage/**/*.png.meta
/Bundled/DialogueImage/**/*.PNG.meta

# Battle background art (keep prefabs/shaders/materials/scripts)
/Resources/Background/**/*.png
/Resources/Background/**/*.PNG
/Resources/Background/**/*.png.meta
/Resources/Background/**/*.PNG.meta
/Bundled/Background/**/*.png
/Bundled/Background/**/*.PNG
/Bundled/Background/**/*.png.meta
/Bundled/Background/**/*.PNG.meta

# Optional local/OS noise
*.tmp
*.bak
*.swp
*.origin
*.psd
*.psd.meta
Thumbs.db
Desktop.ini

# Local cloud-save credentials (copy from SupabaseSettings.example.asset)
/Resources/Private/SupabaseSettings.asset
/Resources/Private/SupabaseSettings.asset.meta

# Dev leftovers (kept on disk, not versioned)
/Script/System/AnimationDisplayer.cs.origin
/Resources/Units/testers/
/Resources/Units/testers.meta
/Resources/Units/Forbiden/
/Resources/Units/Forbiden.meta
/Resources/Units/AnimationTestUnit.prefab
/Resources/Units/AnimationTestUnit.prefab.meta
/Bundled/Units/charAnimTemp/
/Bundled/Units/charAnimTemp.meta
/Resources/LevelData/LevelEnemyData/world1.zip
/Resources/LevelData/LevelEnemyData/world1.zip.meta
/Resources/LevelData/LevelEnemyData/tests/
/Resources/LevelData/LevelEnemyData/tests.meta
/Resources/LevelData/LevelEnemyData/111/
/Resources/LevelData/LevelEnemyData/111.meta
/Resources/LevelData/Chapters/CPImages/cpimg.psd
/Resources/LevelData/Chapters/CPImages/cpimg.psd.meta
