using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Linq;
using Unity.VisualScripting;
using UnityEngine;

public abstract class Character : MonoBehaviour
{
    public string Name;
    public bool isEliteUnit = false;
    public bool affectByStrategy = false;
    //public bool isBase = false;
    public float Power = 1;
    public List<AttackType> ATKTypes;
    public ATKInfo[] atkInfos;
    public bool areaATK;
    public int atkDuration;
    public bool one_off;
    public int Health;
    public int KB;
    public int Speed;
    public int Reload;
    public int DetectionRange;
    public int Cost;
    public int Cooldown;

    public Traits traits = new Traits();
    public TraitSpecials traitSpecials=new TraitSpecials();
    public SubTraits subtraits = new SubTraits();
    public Careers career = new Careers();
    public AgainstCareer againstCareer = new AgainstCareer();
    public DamageRelatedEffect DRE = new DamageRelatedEffect();
    public CharacterEffect[] characterEffects;
    public CharacterAbility[] characterAbilities;
    public AttackTypeResistance[] atkTypeResis;
    public CharacterEffect[] effectResistances;
    //TESTIFICATE CONTENTS
    //protected object[] ATK_Effects=null;
    //
    //
    protected int level = 1;
    protected int maxHealth;
    protected int realHealth;
    protected int[] realDamage;
    protected int animateStep = 0;
    protected int realKBtimes;
    protected int realSpeed;
    protected int realReload;
    protected float hardness;
    //protected int strategy = 0;
    [SerializeField]protected float ATK_muiltipier = 1;
    protected float MAX_muiltipier = 1;
    protected float skillfactor = 1;

    protected bool UNITYAnimated = false;
    protected Animator animator;
    protected BoxCollider2D volumeBox;
    protected BoxCollider2D attackBox;
    public AnimationDisplayer animatorDisplayer;
    protected int animatedframes = 0;
    //protected TargetReceiver receiver;

    protected bool onKB = false;
    protected bool onATK = false;
    protected bool onCurse = false;
    public bool[] effectMarkedSlots= new bool[5];
    protected float startingY = 1;
    protected Coroutine coroutineKB = null;
    protected EffectManager EM;
    protected List<PassiveNode> passiveEffects = new List<PassiveNode>();
    protected void StartPos()
    {
        //float lay = UnityEngine.Random.Range(-0.1f, 0.1f);
        //this.transform.position = new Vector3(transform.position.x, lay, -lay);
        startingY=transform.position.y;
    }
    protected string compareTagName = "";
    public List<GameObject> Targets=new List<GameObject>();

    /*------------------------------------------------------------------------------------------------------------------*/
    // Start is called before the first frame update
    void Start()
    {
        if (!name.Contains("Base")&& !name.Contains("wave")&& !name.Contains("surge"))
        {
            if(UNITYAnimated)animator = GetComponent<Animator>();
            else animatorDisplayer = GetComponent<AnimationDisplayer>();
            Rigidbody2D rb = transform.AddComponent<Rigidbody2D>();
            rb.bodyType = RigidbodyType2D.Kinematic;
            BoxCollider2D bc = transform.AddComponent<BoxCollider2D>();
            bc.offset = new Vector2(CompareTag("Cat") ? 1 : -1, 2);
            bc.size = new Vector2(2, 4);
            GameObject atkbox = Instantiate(Resources.Load<GameObject>("Units/AttackBox"), Vector3.zero, Quaternion.identity);
            atkbox.transform.SetParent(transform, false);
            attackBox = atkbox.GetComponent<BoxCollider2D>();
        }
        volumeBox = GetComponent<BoxCollider2D>();
        realSpeed = Speed;
        realReload = Reload;
        SetAttackRange(0, DetectionRange);
        StartPos();
        EM = GameObject.Find("Effects").GetComponent<EffectManager>();
        InitializeCharacter();
        Passive_OnDeployUnit();
    }
    // Update is called once per frame
    void FixedUpdate()
    {
        realReload++;
    }
    private void Update()
    {
        UpdateAnimation();
    }
    /*------------------------------------------------------------------------------------------------------------------*/
    public abstract void InitializeCharacter();
    public abstract void UpdateAnimation();
    //public abstract void GetStrategy();
    public abstract float GetFactor();
    public virtual void SetAttackRange(float near, float far) { }
    public virtual void DMG_DREeffects(ref float DMG, DamageRelatedEffect dre) { }
    public virtual void DMG_SubTraitsEffects(ref float DMG, SubTraits opponentSubtraits) { }

    #region Attack Functions
    public void Attack(GameObject specific = null)
    {
        Character GetTarget<T>(GameObject go) where T : Character
        {
            if (go == null) return null;
            if (go.CompareTag("Cat"))
                return go.GetComponent<CatCharacter>() as T;
            else
                return go.GetComponent<EnemyCharacter>() as T;
        }

        if (Targets.Count != 0 || specific != null)
        {
            List<CharacterEffect> decisionEff = new List<CharacterEffect>();
            List<AttackType> types = new List<AttackType>();
            foreach (var at in ATKTypes) types.Add(at);
            float dmg = realDamage[animateStep] * ATK_muiltipier;
            Passive_OnAttacking(ref dmg, ref types);
            if (specific != null)
            {
                decisionEff = DetermineSelfATKEffects();
                Character Target = GetTarget<Character>(specific);
                Target?.ReceiveAttack(dmg * ATK_muiltipier, traits, subtraits, againstCareer, DRE, decisionEff, types);
            }
            else
            {
                if (!onCurse && !atkInfos[animateStep].DoNotTriggerEffects)
                {
                    decisionEff = DetermineSelfATKEffects();
                }

                if (!areaATK)
                {
                    Character Target = GetTarget<Character>(FindNearest());
                    Target?.ReceiveAttack(dmg * ATK_muiltipier, traits, subtraits, againstCareer, DRE, decisionEff, types);
                }
                else
                {
                    for (int i = 0; i < Targets.Count; i++)
                    {
                        Character ec = GetTarget<Character>(Targets[i]);
                        ec?.ReceiveAttack(dmg * ATK_muiltipier, traits, subtraits, againstCareer, DRE, decisionEff, types);
                    }
                }
                if (!atkInfos[animateStep].DoNotTriggerEffects)
                {
                    Passive_OnAfterAttack(dmg, decisionEff, types);
                }
            }
        }

        animateStep++;
        if (animateStep == realDamage.Length)
        {
            FinishAttack();
        }
        else
        {
            SetAttackRange(atkInfos[animateStep].ATKRange.x, atkInfos[animateStep].ATKRange.y);
        }
    }
    protected List<CharacterEffect> DetermineSelfATKEffects()
    {
        List<CharacterEffect> de = new List<CharacterEffect>();
        float skillfactor = GetFactor();
        foreach (var ce in characterEffects) if (Random.Range(0, 100) < ce.probability * skillfactor) { de.Add(ce); }
        return de;
    }
    protected void FinishAttack()
    {
        realReload = 0; animateStep = 0;
    }
    protected void ExitAttack()
    {
        if (one_off) { Destroy(gameObject); }
        onATK = false;
        animatedframes = 0;
        //if(animator!=null)animator.SetInteger("state", 0); 
        if (animatorDisplayer != null) animatorDisplayer.SetMaanimPointer(0);
    }
    protected static bool AreCorrespondingTraits(Traits traits1, Traits traits2)
    {
        return (traits1.Red && traits2.Red) ||
               (traits1.Flt && traits2.Flt) ||
               (traits1.Blk && traits2.Blk) ||
               (traits1.Mtl && traits2.Mtl) ||
               (traits1.Ang && traits2.Ang) ||
               (traits1.Aln && traits2.Aln) ||
               (traits1.Z && traits2.Z) ||
               (traits1.Re && traits2.Re) ||
               (traits1.Aku && traits2.Aku) ||
               (traits1.None && traits2.None);
    }
    public void SetNewTarget(GameObject newTarget, bool quickTrigger) { if (quickTrigger) Attack(newTarget); else Targets.Add(newTarget); }
    public void RemoveTarget(GameObject newTarget) { Targets.Remove(newTarget); }
    public void RemoveAllTarget() { Targets = new List<GameObject>(); }
    public GameObject FindNearest()
    {
        Targets.RemoveAll(go => go == null);
        if (Targets.Count == 0) return null;
        bool positive = compareTagName == "Enemy";
        GameObject target = Targets[0];
        foreach (var go in Targets)
        {
            if (target.transform.position.x < go.transform.position.x == positive) target = go;
        }
        return target;
    }//Find the min-distance inside the targets list
    public void SetATKmuiltipier(float ratio) { ATK_muiltipier = ratio; }
    public void SetMAXmuiltipier(float ratio) { MAX_muiltipier = ratio; }
    public void SetMuiltipierToMAX() { ATK_muiltipier = MAX_muiltipier; }

    public void Supporter_Target_Switch(bool switchback=false)
    {
        attackBox.gameObject.GetComponent<TargetReceiver>().Switch_Detection(switchback);
    }
    #endregion

    #region Under Attack Functions
    protected void TakeEffects(List<CharacterEffect> enemyEffect, bool sageBuff = false)
    {
        if (enemyEffect == null) return;
        float sagemultiplier = (subtraits.Sage && !sageBuff) ? 0.3f : 1;
        foreach (var ee in enemyEffect)
        {
            int resisted = 0;
            foreach (var myer in effectResistances)
            {
                if (ee.name == myer.name)
                {
                    resisted = myer.intensity;
                    break;
                }
            }
            EffectInstaller.Inflict(gameObject, ee.name, ee.duration * sagemultiplier * CounterT(resisted), ee.intensity);
        }
    }
    //public abstract void ReceiveAttack(float DMG, Traits enemyTraits, SubTraits opponentSubtraits, AgainstCareer opponentCE, DamageRelatedEffect dre, List<CharacterEffect> enemyEffect, List<AttackType> atkTypes);
    public virtual void ReceiveAttack(float DMG, Traits enemyTraits, SubTraits opponentSubtraits, AgainstCareer opponentAC, DamageRelatedEffect dre, List<CharacterEffect> enemyEffect, List<AttackType> atkTypes)
    {
        Passive_OnBeforeTakeDamage(ref DMG,atkTypes);
        foreach (var ar in atkTypeResis)
        {
            foreach (var at in atkTypes)
            {
                if (ar.type == at)
                {
                    if (ar.intensity > 99) { HitEffect(new List<AttackType>{ AttackType.wave_invalid}); return; }
                    else { DMG *= (100 - ar.intensity) / 100f; }
                }
            }
        }
        bool matchedTraits = AreCorrespondingTraits(enemyTraits, traits);
        if (matchedTraits) DMG_DREeffects(ref DMG, dre);
        DMG_SubTraitsEffects(ref DMG, opponentSubtraits);
        DMG_CarrerEffects(ref DMG, opponentAC);
        TakeDMG(DMG);
        TakeEffects(enemyEffect, subtraits.Sage);
        HitEffect(atkTypes);
        Passive_OnAfterTakeDamage();
    }
    protected void DMG_CarrerEffects(ref float DMG, AgainstCareer opponentAC)
    {
        if (career.Warrior && opponentAC.AggainstWarrior ||
            career.Deffender && opponentAC.AggainstDeffender ||
            career.Magician && opponentAC.AggainstMagician ||
            career.Supporter && opponentAC.AggainstSuppoter ||
            career.Practician && opponentAC.AggainstPractician)
            DMG *= 4;
    }
    protected void TakeDMG(float DMG)
    {
        int afterhealth = realHealth - (int)DMG;
        Debug.Log(DMG);
        if (DMG < 0) EffectInstaller.Inflict(gameObject, AttackType.heal, 1, 1);
        else if (afterhealth < maxHealth - (realKBtimes + 1) * hardness)
        {
            realKBtimes = (int)((maxHealth - afterhealth) / hardness);
            if (coroutineKB == null) coroutineKB = StartCoroutine(PerformKB());
        }
        realHealth = afterhealth;
        if (realHealth > Health) realHealth = Health;
    }
    protected float CounterT(int duration) { return (100 - duration) / 100f; }
    public virtual void StartKBCoroutine(KB_Type kbt = KB_Type.none, float DX = 350) { if (coroutineKB == null) coroutineKB = StartCoroutine(PerformKB(kbt, DX)); }
    protected IEnumerator PerformKB(KB_Type kbt = KB_Type.none, float DX = 350)
    {
        int duration = 24;
        float speedY = 9;
        switch (kbt)
        {
            case KB_Type.none: duration = 24; DX = 350; speedY = 9; break;
            case KB_Type.knockBack: duration = 15; speedY = 0; break;
            case KB_Type.pushBack: duration = 12; DX = 60; speedY = 4; break;
            case KB_Type.bossShock: duration = 45; DX = 1050; speedY = 9; break;
            default: break;
        }
        float speedX = DX / duration * 0.3f;
        int d1 = duration * 2 / 3;
        int d2 = duration - d1;
        volumeBox.enabled = false;
        attackBox.enabled = false;
        onKB = true; onATK = false;
        //if(animator!=null)animator.SetInteger("state", 2);//
        if (animatorDisplayer != null) animatorDisplayer.SetMaanimPointer(3);

        Passive_OnBeforeKB();

        int sign = gameObject.CompareTag("Cat") ? 1 : -1;
        for (int i = 0; i < duration; i++)
        {
            if (i <= d1) this.transform.Translate(new Vector2(sign * speedX, speedY - (speedY * i / (d1 / 2))) * Time.deltaTime);
            else this.transform.Translate(new Vector2(sign * speedX, speedY - (speedY * (i - d1) / (d2 / 2))) * Time.deltaTime);
            if (i == duration - 1)
            {
                if (realHealth < 0)
                {
                    Passive_OnDead();
                    Dead();
                }// check death
                transform.position = new Vector2(transform.position.x, startingY);
                //if (animator != null) animator.SetInteger("state", 0);//
                if (animatorDisplayer != null) animatorDisplayer.SetMaanimPointer(0);
                volumeBox.enabled = true;
                attackBox.enabled = true;
                onKB = false;
                coroutineKB = null;
                //GetStrategy();
            }
            yield return new WaitForFixedUpdate();//Operate per frame
        }
        Passive_OnAfterKB();
    }//Play KB animation, with disable everything else
    protected void HitEffect(List<AttackType> types)
    {
        //Under attacked
        //EM.InstantiateEffect(SEnums.bite, transform.position.x);
        if(types.Count==0) EM.InstantiateEffect(SEnums.bite, transform.position.x);
        else foreach (var t in types)
        {
            switch (t)
            {
                case AttackType.none: EM.InstantiateEffect(SEnums.bite, transform.position.x); break;
                case AttackType.wave: EM.InstantiateEffect(SEnums.bite, transform.position.x); break;
                case AttackType.surge: EM.InstantiateEffect(SEnums.bite, transform.position.x); break;
                case AttackType.wave_invalid: EM.InstantiateEffect(SEnums.wave_invalid, transform.position.x); break;
                case AttackType.invalid: EM.InstantiateEffect(SEnums.invalid, transform.position.x); break;
                case AttackType.critical: EM.InstantiateEffect(SEnums.critical, transform.position.x); break;
                case AttackType.savage: EM.InstantiateEffect(SEnums.savage, transform.position.x); break;
                case AttackType.zombieKiller: if(traits.Z&&realHealth<0) EM.InstantiateEffect(SEnums.soulStrike, transform.position.x); break;
                default:break;
            }
        }
    }
    public virtual void Dead()
    {
        EM.InstantiateEffect(SEnums.soul, transform.position.x);
        Destroy(gameObject);
        if(coroutineKB!=null)StopCoroutine(coroutineKB);
    }
    protected void BaseResist()
    {
        var list = atkTypeResis?.ToList() ?? new List<AttackTypeResistance>();
        list.Add(new AttackTypeResistance { type = AttackType.wave, intensity = 100 });
        list.Add(new AttackTypeResistance { type = AttackType.surge, intensity = 100 });
        list.Add(new AttackTypeResistance { type = AttackType.explosion, intensity = 100 });
        atkTypeResis = list.ToArray();
    }
    #endregion

    #region Passive Skills
    protected void Passive_OnDeployUnit() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnDeployUnit(this); } }
    protected void Passive_OnStartAttack() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnStartAttack(this); } }
    protected void Passive_OnFinishAttack() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnFinishAttack(this); } }
    protected void Passive_OnAttacking(ref float dmg, ref List<AttackType> types) { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnAttacking(this, ref dmg, ref types); } }
    protected void Passive_OnAfterAttack(float dmg, List<CharacterEffect> ces, List<AttackType> types) { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnAfterAttack(this,dmg,ces,types); } }
    protected void Passive_OnAfterTakeDamage() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnAfterTakeDamage(this); }}
    protected void Passive_OnBeforeTakeDamage(ref float dmg, List<AttackType> types) { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnBeforeTakeDamage(this,ref dmg,types); } }
    protected void Passive_OnBeforeKB() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnBeforeKB(this); } }
    protected void Passive_OnAfterKB() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnAfterKB(this); } }
    protected void Passive_OnDead() { var snapshot = passiveEffects.ToArray(); foreach (var effect in snapshot) { effect?.OnDead(this); } }
    public void AddPassiveEffect(PassiveNode passiveEffect) { passiveEffects.Add(passiveEffect); }
    public void RemovePassiveEffect(PassiveNode passiveEffect) { passiveEffects.Remove(passiveEffect); }
    public void Wave_Attack(int level, bool mini, float DMG, List<CharacterEffect> enemyEffect, List<AttackType> atkTypes)
    {
        string e = IsCat() ? "Cat Units" : "Enemy Units";
        GameObject wu = Resources.Load<GameObject>($"Units/{e}/waveunit");
        WaveUnit ww = Instantiate(wu, transform.position, Quaternion.identity).GetComponent<WaveUnit>();
        ww.BeginWaveAttack(level, mini, DMG, traits, subtraits, againstCareer, DRE, enemyEffect, atkTypes);
    }
    #endregion

    #region External Modifiers
    public void SetSearchTagName(string name) { compareTagName = name; }
    public void SetPower(float pw) { Power = pw; }
    public void SetSkillFactor(float sf) { skillfactor = sf; }
    public float TBCspeedTranslator(int spd) { return spd / 10f; }
    public void ChangeSpeed(int spd) { realSpeed = spd; }
    public void SetCurseStatus(bool curse) { onCurse = curse; }
    public float GetHealth() { return realHealth; }
    public bool IsCat() { return gameObject.CompareTag("Cat"); }
    public void SetHealth(int rh) { realHealth = rh; }
    public void ResetKBtimes() { realKBtimes--; }
    public int GetRealSpeed() { return realSpeed; }
    #endregion

    #region Data Loader
    public void LoadCharacterData(char tag, string code)
    {
        CharacterData cd;
        string path;
        if (tag == 'c') { path = $"Units/Cat Units/{code[0]}/{code[1]}{code[2]}{code[3]}/{code[4]}/data"; }
        else path = $"Units/Enemy Units/{code}/data";
        cd = Resources.Load<CharacterData>(path).Clone();
        //SaveSystem.TestSave(Application.streamingAssetsPath + $"/{code}.json", cd);

        Name = cd.Name;
        isEliteUnit = cd.isEliteUnit;
        //affectByStrategy = cd.affectByStrategy;
        ATKTypes = cd.ATKType;
        atkInfos = cd.atkInfos;
        areaATK = cd.areaATK;
        atkDuration = cd.atkDuration;
        one_off = cd.one_off;
        Health = cd.Health;
        KB = cd.KB;
        Speed = cd.Speed;
        Reload = cd.Reload;
        DetectionRange = cd.DetectionRange;
        Cost = cd.Cost;
        Cooldown = cd.Cooldown;
        UNITYAnimated = cd.UNITYAnimated;

        traits = cd.traits;
        traitSpecials = cd.traitSpecials;
        subtraits = cd.subtraits;
        career = cd.career;
        againstCareer = cd.againstCareer;
        DRE = cd.DRE;
        characterEffects = cd.characterEffects;
        characterAbilities = cd.abilities;
        foreach (var ca in characterAbilities) AbilityInstaller.Install(this, ca);
        atkTypeResis = cd.atkTypeResis;
        effectResistances = cd.effectResistances;
    }
    #endregion
}

