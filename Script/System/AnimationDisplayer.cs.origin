public class AnimationDisplayer : MonoBehaviour
{
    protected class MaanimNode
    {
        public class Point
        {
            int frame;
            int value;
            int easing;
            int parameter;
            public int Frame { get => frame; }
            public int Value { get => value; }
            public int Easing { get => easing; }
            public int Parameter { get => parameter; }
            public Point(int _Frame, int _Value, int _Easing, int _Parameter)
            {
                frame = _Frame;
                value = _Value;
                easing = _Easing;
                parameter = _Parameter;
            }
            public string GetDetails()
            {
                string p = "F: " + Frame + " V: " + Value + " E: " + Easing + " P: " + Parameter;
                return p;
            }
        }
        int controllPart;
        public int ControllPart { get => controllPart; }
        int modificationID;
        public int ModificationID { get => modificationID; }
        int loop;
        public int Loop { get => loop; }
        string Name;
        public int LastPoint = 0;
        int startFrame = 0;
        int endFrame = 0;
        int totalFrame = 0;
        public int StartFrame { get => startFrame; }
        public int EndFrame { get => endFrame; }
        public int TotalFrame { get => totalFrame; }
        Point[] pointList;
        public Point[] PointList { get => pointList; }
        public MaanimNode(int Object, int _ModificationID, int _Loop, string _Name, int _TotalPoint)
        {
            controllPart = Object;
            modificationID = _ModificationID;
            loop = _Loop;
            Name = _Name;
            pointList = new Point[_TotalPoint];
        }
        public string GetDetails()
        {
            string p = "Node- C: " + ControllPart + " M: " + ModificationID + " L: " + Loop + " N:" + Name + '\n';
            for (int i = 0; i < pointList.Length; i++)
            {
                p = p + pointList[i].GetDetails() + '\n';
            }
            return p;
        }
        public void AddPoint(int _Frame, int _Value, int _Easing, int _Parameter, int _Point)
        {
            pointList[_Point] = new Point(_Frame, _Value, _Easing, _Parameter);
        }
        public void Initialize()
        {
            startFrame = pointList[0].Frame;
            endFrame = pointList[pointList.Length - 1].Frame;
            totalFrame = -StartFrame + EndFrame;
        }
    }
    public GameObject Target = null;
    public GameObject Empty;
    [SerializeField] protected Texture2D picture;
    public TextAsset ImgcutTextAsset;
    public TextAsset ModelTextAsset;
    [SerializeField] protected int maanimPointer = 0;
    public int MaanimPointer {get => maanimPointer;}
    public TextAsset[] MaanimTextAsset = new TextAsset[4];
    public Material additiveMaterial;
    public Material changeMaterial;
    [SerializeField] protected Sprite[] SpritesList;
    [SerializeField] protected GameObject[] ObjectList;//存子物件
    protected string[,] ImgcutData;
    protected string[,] ModelData;
    protected MaanimNode[][] MaanimData;
    protected float[,] ModelTree;//0 parent  1 near  2 first child  3 opacity 4 muti
    protected float[,] ModelTree_Fixed;
    protected int[] animationTotalFrame;
    public int[] AnimationTotalFrame {get => animationTotalFrame;}
    protected const int PARENT = 0;
    protected const int NEAR = 1;
    protected const int FIRST_CHILD = 2;
    protected const int OPACITY = 3;
    protected const int MULTIPLY = 4;
    protected const int SCALE = 5;
    protected const int SCALE_X = 6;
    protected const int SCALE_Y = 7;
    protected const int HORIZONTAL_FLIP = 8;
    protected const int VERTICAL_FLIP = 9;
    protected const int ROTATION_FLIP = 10;
    protected const int ROTATION = 11;
    [SerializeField] protected int PixelPerUnit = 100;
    [SerializeField] protected float PositionRate = 1;
    [SerializeField] protected float PivotRate = 1;
    [SerializeField] protected float ScaleRate = 0.001f;
    [SerializeField] protected float RotationRate = 0.1f;
    [SerializeField] protected float OpacityRate = 0.001f;
    [SerializeField] protected float GlowRate = 0.5f;
    [SerializeField] protected float AnimationSpeedRate = 1;
    [SerializeField] protected float CurrentFrame = 0;
    [SerializeField] protected int CheckControlPart = -1;
    [SerializeField] protected int CheckModificationID = -1;
    [SerializeField] protected bool InitializeWhenStart = false;
    [SerializeField] string DisplayLayer = "Charater";
    //MODIFIED
    protected int baseSortingOrder = 0;
    public void SetBaseSortingOrder(int sl) {  baseSortingOrder = sl*100; }
    //
    protected void Decrypt_Imgcut()
    {
        int TotalLine_Imgcut;
        string[] _LineImgData = ImgcutTextAsset.text.Split('\n');
        TotalLine_Imgcut = int.Parse(_LineImgData[3]);
        ImgcutData = new string[TotalLine_Imgcut, 5];
        for (int i = 0; i < TotalLine_Imgcut; i++)
        {
            string[] _ImgData = _LineImgData[4 + i].Split(",");
            string p = i + " : ";
            for (int j = 0; j < 5; j++)
            {
                if (j != 4 || (j == 4 && _ImgData.Length >= 5))
                {
                    ImgcutData[i, j] = _ImgData[j];
                }
                p += ImgcutData[i, j] + " ";
            }
            //Debug.Log(p);
        }

        SpritesList = new Sprite[TotalLine_Imgcut];
        for (int i = 0; i < TotalLine_Imgcut; i++)
        {
            int x = int.Parse(ImgcutData[i, 0]);
            int y = picture.height - int.Parse(ImgcutData[i, 1]) - int.Parse(ImgcutData[i, 3]) + 1;
            int width = int.Parse(ImgcutData[i, 2]);
            int height = int.Parse(ImgcutData[i, 3]);
            try
            {
                SpritesList[i] = Sprite.Create(picture, new Rect(x, y, width, height), new Vector2(0, 1f));
            }
            catch//
            {
                y -= 1;
                SpritesList[i] = Sprite.Create(picture, new Rect(x, y, width, height), new Vector2(0, 1f));
            }
            SpritesList[i].name = ImgcutData[i, 4];
        }
    }
    protected void Decrypt_Mamodel()
    {
        int TotalLine_Mamodel;
        string[] _LineModelData = ModelTextAsset.text.Split('\n');
        TotalLine_Mamodel = int.Parse(_LineModelData[2]);
        ModelData = new string[TotalLine_Mamodel, 14];

        for (int i = 0; i < TotalLine_Mamodel; i++)
        {
            string[] _ModelData = _LineModelData[3 + i].Split(",");
            string p = i + " : ";
            for (int j = 0; j < 14; j++)
            {
                if (j != 13 || (j == 13 && _ModelData.Length >= 14))
                {
                    ModelData[i, j] = _ModelData[j];
                }
                p += ModelData[i, j] + " ";
            }
            //Debug.Log(p);
        }
    }
